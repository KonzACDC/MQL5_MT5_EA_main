//+------------------------------------------------------------------+
//| 致命的エラーのチェック                                          |
//+------------------------------------------------------------------+
bool IsCriticalError(int errorCode)
{
   int criticalErrors[] = {133, 139, 145, 146, 147, 148, 149, 150, 4051};
   for(int i=0; i<ArraySize(criticalErrors); i++) 
      if(errorCode == criticalErrors[i]) return true;
   return false;
}

//+------------------------------------------------------------------+
//| ロットサイズ調整                                                |
//+------------------------------------------------------------------+
double AdjustLotSize(string symbol, double requestedLot, int errorCode)
{
   double minLot = SymbolInfoDouble(symbol, SYMBOL_VOLUME_MIN);
   double maxLot = SymbolInfoDouble(symbol, SYMBOL_VOLUME_MAX);
   double stepLot = SymbolInfoDouble(symbol, SYMBOL_VOLUME_STEP);
   double balance = AccountInfoDouble(ACCOUNT_BALANCE);
   double equity = AccountInfoDouble(ACCOUNT_EQUITY);
   
   // 無効なロットサイズエラー (131)
   if(errorCode == 131) 
   {
      if(requestedLot < minLot) return minLot;
      if(requestedLot > maxLot) return maxLot;
      
      double adjustedLot = NormalizeDouble(requestedLot / stepLot, 0) * stepLot;
      if(adjustedLot != requestedLot) return adjustedLot;
   }
   
   // 資金不足エラー (134)
   if(errorCode == 134) 
   {
      double marginRequired;
      if(OrderCalcMargin(ORDER_TYPE_BUY, symbol, requestedLot, SymbolInfoDouble(symbol, SYMBOL_ASK), marginRequired))
      {
         double maxAffordableLot = requestedLot;
         while(marginRequired > equity * 0.8 && maxAffordableLot > minLot)
         {
            maxAffordableLot -= stepLot;
            if(!OrderCalcMargin(ORDER_TYPE_BUY, symbol, maxAffordableLot, SymbolInfoDouble(symbol, SYMBOL_ASK), marginRequired))
               break;
         }
         if(maxAffordableLot >= minLot) return maxAffordableLot;
      }
   }
   return -1;
}

//+------------------------------------------------------------------+
//| 取引が許可されているか確認                                      |
//+------------------------------------------------------------------+
bool IsTradeAllowed(string symbol)
{
   if(!SymbolInfoInteger(symbol, SYMBOL_SELECT)) return false;
   if(!TerminalInfoInteger(TERMINAL_TRADE_ALLOWED)) return false;
   if(!SymbolInfoInteger(symbol, SYMBOL_TRADE_MODE)) return false;
   if(AccountInfoInteger(ACCOUNT_TRADE_EXPERT) == 0) return false;
   if(AccountInfoDouble(ACCOUNT_MARGIN_LEVEL) > 0 && 
      AccountInfoDouble(ACCOUNT_MARGIN_LEVEL) < 100) return false;
   return true;
}
