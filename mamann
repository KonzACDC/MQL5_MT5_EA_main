//+------------------------------------------------------------------+
//| ポジション情報同期関数                                          |
//+------------------------------------------------------------------+
void SyncPositionData()
  {
   for(int i = 0; i < 3; i++)
     {
      string symbol = GetSymbolByIndex(i);
      if(symbol == "")
         continue;

      if(PositionSelect(symbol))
        {
         ulong ticket = PositionGetInteger(POSITION_TICKET);
         // 新しいポジションを検出
         if(positionInfo[i].ticket != ticket)
           {
            positionInfo[i].ticket = ticket;
            positionInfo[i].entryPrice = PositionGetDouble(POSITION_PRICE_OPEN);
            positionInfo[i].entryTime = (datetime)PositionGetInteger(POSITION_TIME);
            positionInfo[i].currentATR = GetATR(symbol, i);

            // トレーリングストップ変数を初期化
            positionInfo[i].bestPrice = positionInfo[i].entryPrice;
            positionInfo[i].trailingActivated = false;
            positionInfo[i].trailingStart = 0;
            positionInfo[i].lastTrailBar = 0;

            // 初期SL/TP計算（ATRを使用）
            double range = GetAverageRange(symbol, GetSymbolIndex(symbol));
            if(range > 0)
              {
               if(PositionGetInteger(POSITION_TYPE) == POSITION_TYPE_BUY)
                 {
                  positionInfo[i].slPrice = positionInfo[i].entryPrice - range * ATR_Multiplier;
                  positionInfo[i].tpPrice = positionInfo[i].entryPrice + range * TP_ATR_Multiplier;

                  // トレーリング開始価格を計算
                  positionInfo[i].trailingStart = positionInfo[i].entryPrice + range * TrailingStart_ATR;
                 }
               else
                 {
                  positionInfo[i].slPrice = positionInfo[i].entryPrice + range * ATR_Multiplier;
                  positionInfo[i].tpPrice = positionInfo[i].entryPrice - range * TP_ATR_Multiplier;

                  // トレーリング開始価格を計算
                  positionInfo[i].trailingStart = positionInfo[i].entryPrice - range * TrailingStart_ATR;
                 }
              }
            Print("New position detected for ", symbol,
                  " Ticket: ", ticket,
                  " Entry: ", positionInfo[i].entryPrice,
                  " SL: ", positionInfo[i].slPrice,
                  " TP: ", positionInfo[i].tpPrice,
                  " Trailing Start: ", positionInfo[i].trailingStart,
                  " Current ATR: ", positionInfo[i].currentATR);
           }
        }
      else
        {
         // ポジションが存在しない場合、内部データをリセット
         if(positionInfo[i].ticket != 0)
           {
            positionInfo[i].slPrice = 0;
            positionInfo[i].tpPrice = 0;
            positionInfo[i].ticket = 0;
            positionInfo[i].confidence = 0;
            positionInfo[i].bestPrice = 0;
            positionInfo[i].trailingActivated = false;
            positionInfo[i].trailingStart = 0;
            positionInfo[i].currentATR = 0;
            positionInfo[i].lastTrailBar = 0;
           }
        }
     }
  }

//+------------------------------------------------------------------+
//| トレーリングストップ処理関数                                    |
//+------------------------------------------------------------------+
void ProcessTrailingStop()
  {
   for(int i = 0; i < 3; i++)
     {
      string symbol = GetSymbolByIndex(i);
      if(symbol == "" || positionInfo[i].ticket == 0)
         continue;

      if(!PositionSelect(symbol))
         continue;

      // 現在のポジション情報を取得
      ENUM_POSITION_TYPE posType = (ENUM_POSITION_TYPE)PositionGetInteger(POSITION_TYPE);
      double currentPrice = (posType == POSITION_TYPE_BUY) ?
                            SymbolInfoDouble(symbol, SYMBOL_BID) :
                            SymbolInfoDouble(symbol, SYMBOL_ASK);

      // トレーリング間隔チェック（バー数ベース）
      datetime currentBarTime = iTime(symbol, _Period, 0);
      int barIndex = iBarShift(symbol, _Period, currentBarTime);

      if(MathAbs(barIndex - positionInfo[i].lastTrailBar) < TrailEveryXBars)
        {
         continue; // トレーリング間隔が経過していない
        }

      // 最良価格を更新
      if(posType == POSITION_TYPE_BUY)
        {
         if(currentPrice > positionInfo[i].bestPrice)
           {
            positionInfo[i].bestPrice = currentPrice;
           }
        }
      else
        {
         if(currentPrice < positionInfo[i].bestPrice)
           {
            positionInfo[i].bestPrice = currentPrice;
           }
        }

      // トレーリング開始条件チェック
      if(!positionInfo[i].trailingActivated)
        {
         if(posType == POSITION_TYPE_BUY && currentPrice >= positionInfo[i].trailingStart)
           {
            positionInfo[i].trailingActivated = true;
            Print("Trailing stop activated for BUY position: ", symbol,
                  " Current: ", currentPrice,
                  " Trailing Start: ", positionInfo[i].trailingStart);
           }
         else
            if(posType == POSITION_TYPE_SELL && currentPrice <= positionInfo[i].trailingStart)
              {
               positionInfo[i].trailingActivated = true;
               Print("Trailing stop activated for SELL position: ", symbol,
                     " Current: ", currentPrice,
                     " Trailing Start: ", positionInfo[i].trailingStart);
              }
        }

      // トレーリング実行
      if(positionInfo[i].trailingActivated)
        {
         double newSlPrice = CalculateTrailingStop(symbol, i, posType, currentPrice);

         // ストップロスを更新（改善された場合のみ）
         if(posType == POSITION_TYPE_BUY && newSlPrice > positionInfo[i].slPrice)
           {
            UpdateStopLoss(symbol, i, newSlPrice);
            positionInfo[i].lastTrailBar = barIndex;
           }
         else
            if(posType == POSITION_TYPE_SELL && newSlPrice < positionInfo[i].slPrice)
              {
               UpdateStopLoss(symbol, i, newSlPrice);
               positionInfo[i].lastTrailBar = barIndex;
              }
        }
     }
  }

//+------------------------------------------------------------------+
//| トレーリングストップ価格を計算                                  |
//+------------------------------------------------------------------+
double CalculateTrailingStop(string symbol, int symbolIndex, ENUM_POSITION_TYPE posType, double currentPrice)
  {
   double trailDistance = positionInfo[symbolIndex].currentATR * TrailingStep_ATR;
   double newSlPrice = 0;

   if(posType == POSITION_TYPE_BUY)
     {
      if(UsePartialTrailing)
        {
         // 部分的なトレーリング：最良価格から固定距離
         newSlPrice = positionInfo[symbolIndex].bestPrice - trailDistance;
        }
      else
        {
         // 完全なトレーリング：現在価格から固定距離
         newSlPrice = currentPrice - trailDistance;
        }

      // 最低でも初期ストップロスよりは良い価格に設定
      double initialSl = positionInfo[symbolIndex].entryPrice -
                         positionInfo[symbolIndex].currentATR * ATR_Multiplier;
      newSlPrice = MathMax(newSlPrice, initialSl);

     }
   else
      if(posType == POSITION_TYPE_SELL)
        {
         if(UsePartialTrailing)
           {
            // 部分的なトレーリング：最良価格から固定距離
            newSlPrice = positionInfo[symbolIndex].bestPrice + trailDistance;
           }
         else
           {
            // 完全なトレーリング：現在価格から固定距離
            newSlPrice = currentPrice + trailDistance;
           }

         // 最低でも初期ストップロスよりは良い価格に設定
         double initialSl = positionInfo[symbolIndex].entryPrice +
                            positionInfo[symbolIndex].currentATR * ATR_Multiplier;
         newSlPrice = MathMin(newSlPrice, initialSl);
        }

   return newSlPrice;
  }

//+------------------------------------------------------------------+
//| ストップロスを更新                                              |
//+------------------------------------------------------------------+
void UpdateStopLoss(string symbol, int symbolIndex, double newSlPrice)
  {
   MqlTradeRequest request = {};
   MqlTradeResult result = {};

   request.action = TRADE_ACTION_SLTP;
   request.symbol = symbol;
   request.position = positionInfo[symbolIndex].ticket;
   request.sl = newSlPrice;
   request.tp = 0; // TPは変更しない
   request.magic = 0;

// 価格を正規化
   double tickSize = SymbolInfoDouble(symbol, SYMBOL_TRADE_TICK_SIZE);
   double point = SymbolInfoDouble(symbol, SYMBOL_POINT);
   if(tickSize > 0 && point > 0)
     {
      request.sl = NormalizeDouble(request.sl / point, 0) * point;
     }

// 注文送信
   if(OrderSend(request, result))
     {
      positionInfo[symbolIndex].slPrice = newSlPrice;
      Print("Trailing stop updated for ", symbol,
            " New SL: ", DoubleToString(newSlPrice, 5),
            " Best Price: ", DoubleToString(positionInfo[symbolIndex].bestPrice, 5),
            " Profit: ", DoubleToString(PositionGetDouble(POSITION_PROFIT), 2));
     }
   else
     {
      Print("Failed to update trailing stop for ", symbol,
            " Error: ", GetLastError(),
            " Requested SL: ", DoubleToString(newSlPrice, 5));
     }
  }

