// インジケーター初期化
   maHandles[index] = iMA(symbol, _Period, MA_Period, MA_Shift, MA_Method, MA_Applied_Price);
   atrHandles[index] = iATR(symbol, _Period, ATR_Period);

   Print("Initialized indicators for ", symbol,
         ": MA(", MA_Period, ", ", EnumToString(MA_Method), "), ATR(", ATR_Period, ")");
  }

