//+------------------------------------------------------------------+
//| tanh活性化関数                                                   |
//+------------------------------------------------------------------+
double tanhActivation(double x)
  {
// 双曲線正接関数の実装
   double exp2x = MathExp(2 * TanhAlpha * x);
   return (exp2x - 1) / (exp2x + 1);
  }

//+------------------------------------------------------------------+
//| ニューラルネットワーク (2-3-1構造) - tanh活性化関数のみ使用     |
//+------------------------------------------------------------------+
double NeuralNetwork(double &inputs[])
  {
// 隠れ層の計算 (3ユニット)
   double h1[3];
// 入力層(2) → 隠れ層(3)の計算
   h1[0] = inputs[0]*w1_0_0 + inputs[1]*w1_1_0 + b1_0;
   h1[1] = inputs[0]*w1_0_1 + inputs[1]*w1_1_1 + b1_1;
   h1[2] = inputs[0]*w1_0_2 + inputs[1]*w1_1_2 + b1_2;

// Tanh活性化関数（隠れ層）- Leaky ReLUからTanhに変更
   for(int i=0; i<3; i++)
     {
      h1[i] = tanhActivation(h1[i]);
     }

// 出力層の計算
   double output = h1[0]*w2_0 + h1[1]*w2_1 + h1[2]*w2_2 + b2;

// Tanh活性化関数を適用（出力範囲: -1.0～1.0）
   return tanhActivation(output);
  }

//+------------------------------------------------------------------+
//| tanh出力に基づくロット乗数を計算（-1.0～1.0の範囲）             |
//+------------------------------------------------------------------+
double CalculateLotMultiplier(double prediction, ENUM_ORDER_TYPE orderType)
  {
   if(!UseDynamicLot)
      return 1.0;

   double confidence = 0.0;

   if(orderType == ORDER_TYPE_BUY)
     {
      // 買いの場合：predictionがBuyThreshold～1.0
      if(prediction >= BuyThreshold)
        {
         // 信頼度を0.0～1.0に正規化
         confidence = (prediction - BuyThreshold) / (1.0 - BuyThreshold);
        }
     }
   else
      if(orderType == ORDER_TYPE_SELL)
        {
         // 売りの場合：predictionが-1.0～SellThreshold
         if(prediction <= SellThreshold)
           {
            // 信頼度を0.0～1.0に正規化（絶対値で計算）
            confidence = (SellThreshold - prediction) / (SellThreshold + 1.0);
           }
        }
      else
        {
         return 1.0;
        }

// 信頼度を0.0～1.0の範囲にクリップ
   confidence = MathMax(0.0, MathMin(1.0, confidence));

// 線形補間で乗数を計算
   double multiplier = MinLotMultiplier + confidence * (MaxLotMultiplier - MinLotMultiplier);

   return multiplier;
  }

//+------------------------------------------------------------------+
//| ニューラルネットワーク出力に基づくリスク率を計算                 |
//+------------------------------------------------------------------+
double CalculateDynamicRiskPercent(double prediction, ENUM_ORDER_TYPE orderType)
  {
   if(!UseDynamicLot)
      return RiskPercent;

   double multiplier = CalculateLotMultiplier(prediction, orderType);
   double dynamicRisk = RiskPercent * multiplier;

// 最大リスク率で制限
   dynamicRisk = MathMin(dynamicRisk, MaxRiskPercent);
   dynamicRisk = MathMax(dynamicRisk, 0.1); // 最小0.1%

   return dynamicRisk;
  }

//+------------------------------------------------------------------+
//| 取引実行                                                        |
//+------------------------------------------------------------------+
void ExecuteTrade(string symbol, int symbolIndex, double prediction)
  {
// 現在ポジション確認
   bool hasPosition = PositionSelect(symbol);
   int currentPos = hasPosition ?
                    (PositionGetInteger(POSITION_TYPE) == POSITION_TYPE_BUY ? 1 : -1) : 0;

// デバッグ：定期的に予測値を表示
   static int debugCounter = 0;
   debugCounter++;
   if(debugCounter % 100 == 0)
     {
      double maDistance = CalculateNormalizedMADistance(symbol, symbolIndex);
      double maSlope = CalculateNormalizedMASlope(symbol, symbolIndex);
      Print(symbol, " - Neural Network Output: ", DoubleToString(prediction, 4),
            " (Buy threshold: ", BuyThreshold, ", Sell threshold: ", SellThreshold, ")",
            " MA Distance: ", DoubleToString(maDistance, 4),
            " MA Slope: ", DoubleToString(maSlope, 4));
     }

// 反対方向のポジションがあれば決済
   if(prediction >= BuyThreshold && currentPos < 0)
     {
      Print("Closing SELL position due to BUY signal. Prediction: ", DoubleToString(prediction, 4));
      ClosePosition(symbol);
      currentPos = 0; // ポジション状態を更新
     }
   else
      if(prediction <= SellThreshold && currentPos > 0)
        {
         Print("Closing BUY position due to SELL signal. Prediction: ", DoubleToString(prediction, 4));
         ClosePosition(symbol);
         currentPos = 0; // ポジション状態を更新
        }

// エントリー条件：BuyThreshold以上で買い、SellThreshold以下で売り
// 現在ポジションなしの場合のみエントリー
   if(prediction >= BuyThreshold && currentPos == 0)
     {
      double range = GetAverageRange(symbol, symbolIndex);
      if(range <= 0)
        {
         Print("Warning: Invalid range for ", symbol);
         return;
        }

      // ニューラルネットワークの信頼度に基づく動的ロット計算
      double baseLot = CalculateBaseLotSize(symbol, range);
      if(baseLot <= 0)
        {
         Print("Warning: Invalid base lot for ", symbol);
         return;
        }

      double lotMultiplier = CalculateLotMultiplier(prediction, ORDER_TYPE_BUY);
      double lot = baseLot * lotMultiplier;

      // ロットの最小・最大・ステップを考慮して正規化
      lot = NormalizeLotSize(symbol, lot);
      if(lot <= 0)
        {
         Print("Warning: Invalid lot size for ", symbol);
         return;
        }

      // エントリー価格（現在のAsk）
      double price = SymbolInfoDouble(symbol, SYMBOL_ASK);

      // ストップロス価格計算
      double slPrice = price - range * ATR_Multiplier;

      // テイクプロフィット価格計算
      double tpPrice = price + range * TP_ATR_Multiplier;

      // ポジション開設
      if(ExecuteOrder(symbol, ORDER_TYPE_BUY, lot, slPrice, tpPrice, symbolIndex, prediction))
        {
         Print("BUY signal executed: ", symbol,
               " Prediction: ", DoubleToString(prediction, 4),
               " Lot multiplier: ", DoubleToString(lotMultiplier, 2),
               " Lot size: ", DoubleToString(lot, 2),
               " Price: ", DoubleToString(price, 5));
        }
     }
   else
      if(prediction <= SellThreshold && currentPos == 0)
        {
         double range = GetAverageRange(symbol, symbolIndex);
         if(range <= 0)
           {
            Print("Warning: Invalid range for ", symbol);
            return;
           }

         // ニューラルネットワークの信頼度に基づく動的ロット計算
         double baseLot = CalculateBaseLotSize(symbol, range);
         if(baseLot <= 0)
           {
            Print("Warning: Invalid base lot for ", symbol);
            return;
           }

         double lotMultiplier = CalculateLotMultiplier(prediction, ORDER_TYPE_SELL);
         double lot = baseLot * lotMultiplier;

         // ロットの最小・最大・ステップを考慮して正規化
         lot = NormalizeLotSize(symbol, lot);
         if(lot <= 0)
           {
            Print("Warning: Invalid lot size for ", symbol);
            return;
           }

         // エントリー価格（現在のBid）
         double price = SymbolInfoDouble(symbol, SYMBOL_BID);

         // ストップロス価格計算
         double slPrice = price + range * ATR_Multiplier;

         // テイクプロフィット価格計算
         double tpPrice = price - range * TP_ATR_Multiplier;

         // ポジション開設
         if(ExecuteOrder(symbol, ORDER_TYPE_SELL, lot, slPrice, tpPrice, symbolIndex, prediction))
           {
            Print("SELL signal executed: ", symbol,
                  " Prediction: ", DoubleToString(prediction, 4),
                  " Lot multiplier: ", DoubleToString(lotMultiplier, 2),
                  " Lot size: ", DoubleToString(lot, 2),
                  " Price: ", DoubleToString(price, 5));
           }
        }
      else
         if(prediction > SellThreshold && prediction < BuyThreshold)
           {
            // 中立ゾーン：predictionがSellThreshold～BuyThresholdの間
            if(debugCounter % 100 == 0)   // 頻繁にログ出力しない
              {
               Print("Neutral zone - No trade: ", symbol,
                     " Prediction: ", DoubleToString(prediction, 4),
                     " (Buy threshold: ", BuyThreshold,
                     ", Sell threshold: ", SellThreshold, ")");
              }
           }
  }

//+------------------------------------------------------------------+
//| 基本ロットサイズ計算（動的リスク率を使用）                      |
//+------------------------------------------------------------------+
double CalculateBaseLotSize(string symbol, double range)
  {
// リスク管理：ボラティリティ適応型
   double slDistance = range * ATR_Multiplier;
   double slPoints = slDistance / SymbolInfoDouble(symbol, SYMBOL_POINT);

// 1ポイントあたりの価値（1ロット当たり）を計算
   double tickValue = SymbolInfoDouble(symbol, SYMBOL_TRADE_TICK_VALUE);
   double tickSize = SymbolInfoDouble(symbol, SYMBOL_TRADE_TICK_SIZE);
   double point = SymbolInfoDouble(symbol, SYMBOL_POINT);

// 計算の安全チェック
   if(tickSize <= 0 || point <= 0)
     {
      Print("Error: Invalid tickSize or point for ", symbol);
      return 0;
     }

   double valuePerPoint = tickValue / (tickSize / point);
   if(valuePerPoint <= 0)
     {
      Print("Error: Invalid valuePerPoint for ", symbol);
      return 0;
     }

// 基本リスク額計算（口座残高の%）
   double riskMoney = AccountInfoDouble(ACCOUNT_BALANCE) * RiskPercent / 100.0;

// 基本ロットサイズ計算
   double baseLot = riskMoney / (slPoints * valuePerPoint);

   return baseLot;
  }

//+------------------------------------------------------------------+
//| ロットサイズを正規化                                            |
//+------------------------------------------------------------------+
double NormalizeLotSize(string symbol, double lot)
  {
// ロットサイズの最小・最大値チェック
   double minLot = SymbolInfoDouble(symbol, SYMBOL_VOLUME_MIN);
   double maxLot = SymbolInfoDouble(symbol, SYMBOL_VOLUME_MAX);
   double lotStep = SymbolInfoDouble(symbol, SYMBOL_VOLUME_STEP);

   if(minLot <= 0 || maxLot <= 0 || lotStep <= 0)
     {
      Print("Error: Invalid lot size parameters for ", symbol);
      return 0;
     }

   lot = MathMax(lot, minLot);
   lot = MathMin(lot, maxLot);
   lot = NormalizeDouble(lot / lotStep, 0) * lotStep;

   return lot;
  }

//+------------------------------------------------------------------+
//| 注文実行                                                        |
//+------------------------------------------------------------------+
bool ExecuteOrder(string symbol, ENUM_ORDER_TYPE orderType, double lot, double slPrice, double tpPrice, int symbolIndex, double prediction)
  {
   MqlTradeRequest request = {};
   MqlTradeResult result = {};
   int retryCount = 0;
   const int maxRetries = 3;
   int waitMs = 200;

// 取引が許可されているか確認
   if(!IsTradeAllowed(symbol))
      return false;

   while(retryCount < maxRetries)
     {
      // リクエスト設定
      request.action = TRADE_ACTION_DEAL;
      request.symbol = symbol;
      request.volume = lot;
      request.type = orderType;
      request.type_filling = input_Filling_type;
      request.price = orderType == ORDER_TYPE_BUY ?
                      SymbolInfoDouble(symbol, SYMBOL_ASK) :
                      SymbolInfoDouble(symbol, SYMBOL_BID);
      request.deviation = 100;
      request.sl = 0;
      request.tp = 0;

      // 注文実行
      bool success = OrderSend(request, result);

      if(success)
        {
         // ポジション情報を内部記録
         positionInfo[symbolIndex].slPrice = slPrice;
         positionInfo[symbolIndex].tpPrice = tpPrice;
         positionInfo[symbolIndex].entryPrice = result.price;
         positionInfo[symbolIndex].entryTime = TimeCurrent();
         positionInfo[symbolIndex].ticket = result.deal;
         positionInfo[symbolIndex].confidence = prediction;
         positionInfo[symbolIndex].currentATR = GetAverageRange(symbol, symbolIndex);
         positionInfo[symbolIndex].bestPrice = result.price;

         // トレーリング開始価格計算
         double range = positionInfo[symbolIndex].currentATR;
         if(orderType == ORDER_TYPE_BUY)
           {
            positionInfo[symbolIndex].trailingStart = result.price + range * TrailingStart_ATR;
           }
         else
           {
            positionInfo[symbolIndex].trailingStart = result.price - range * TrailingStart_ATR;
           }

         positionInfo[symbolIndex].trailingActivated = false;
         positionInfo[symbolIndex].lastTrailBar = iBarShift(symbol, _Period, iTime(symbol, _Period, 0));

         Print("Order executed: ", symbol,
               " Type: ", EnumToString(orderType),
               " Prediction: ", DoubleToString(prediction, 4),
               " Lot: ", DoubleToString(lot, 2),
               " Price: ", DoubleToString(result.price, 5),
               " SL: ", DoubleToString(slPrice, 5),
               " TP: ", DoubleToString(tpPrice, 5),
               " Trailing Start: ", DoubleToString(positionInfo[symbolIndex].trailingStart, 5),
               " Current ATR: ", DoubleToString(positionInfo[symbolIndex].currentATR, 5));
         return true;
        }
      else
        {
         int errorCode = GetLastError();
         string errorDesc = GetErrorDescription(errorCode);

         Print("Order failed (Attempt ", retryCount+1, "): ",
               "Error ", errorCode, " - ", errorDesc,
               " | Comment: ", result.comment);

         // リトライ不可能な致命的エラーのチェック
         if(IsCriticalError(errorCode))
            return false;

         // ロットサイズ関連エラーの処理
         if(errorCode == 131 || errorCode == 134)
           {
            double newLot = AdjustLotSize(symbol, lot, errorCode);
            if(newLot > 0 && newLot != lot)
              {
               Print("Adjusting lot size from ", DoubleToString(lot, 2), " to ", DoubleToString(newLot, 2));
               lot = newLot;
               continue;
              }
           }

         retryCount++;
         if(retryCount < maxRetries)
           {
            Print("Retrying in ", waitMs, "ms...");
            Sleep(waitMs);
           }
        }
     }

   Print("Order failed after ", maxRetries, " attempts");
   return false;
  }

//+------------------------------------------------------------------+
//| 退出条件チェック（確定足の終値ベース）                          |
//+------------------------------------------------------------------+
void CheckExitConditions(string symbol, int symbolIndex)
  {
   if(positionInfo[symbolIndex].slPrice == 0 || positionInfo[symbolIndex].tpPrice == 0)
      return;

// 確定足の終値を使用
   double close = iClose(symbol, _Period, 1);

   if(PositionSelect(symbol))
     {
      bool shouldClose = false;
      string closeReason = "";
      ENUM_POSITION_TYPE posType = (ENUM_POSITION_TYPE)PositionGetInteger(POSITION_TYPE);

      if(posType == POSITION_TYPE_BUY)
        {
         if(close <= positionInfo[symbolIndex].slPrice)
           {
            shouldClose = true;
            closeReason = "SL";
           }
         else
            if(close >= positionInfo[symbolIndex].tpPrice)
              {
               shouldClose = true;
               closeReason = "TP";
              }
        }
      else
         if(posType == POSITION_TYPE_SELL)
           {
            if(close >= positionInfo[symbolIndex].slPrice)
              {
               shouldClose = true;
               closeReason = "SL";
              }
            else
               if(close <= positionInfo[symbolIndex].tpPrice)
                 {
                  shouldClose = true;
                  closeReason = "TP";
                 }
           }

      if(shouldClose)
        {
         ClosePosition(symbol);
         positionInfo[symbolIndex].slPrice = 0;
         positionInfo[symbolIndex].tpPrice = 0;
         positionInfo[symbolIndex].confidence = 0;
         positionInfo[symbolIndex].bestPrice = 0;
         positionInfo[symbolIndex].trailingActivated = false;
         positionInfo[symbolIndex].trailingStart = 0;

         Print(closeReason, " triggered: ", symbol,
               " Close Price: ", DoubleToString(close, 5),
               " SL: ", DoubleToString(positionInfo[symbolIndex].slPrice, 5),
               " TP: ", DoubleToString(positionInfo[symbolIndex].tpPrice, 5));
        }
     }
  }

//+------------------------------------------------------------------+
//| ポジション決済                                                  |
//+------------------------------------------------------------------+
void ClosePosition(string symbol)
  {
   MqlTradeRequest request = {};
   MqlTradeResult result = {};
   int retryCount = 0;
   const int maxRetries = 3;

   if(!PositionSelect(symbol))
      return;

   double volume = PositionGetDouble(POSITION_VOLUME);
   ENUM_ORDER_TYPE type = PositionGetInteger(POSITION_TYPE) == POSITION_TYPE_BUY ?
                          ORDER_TYPE_SELL : ORDER_TYPE_BUY;

   while(retryCount < maxRetries)
     {
      request.action = TRADE_ACTION_DEAL;
      request.symbol = symbol;
      request.volume = volume;
      request.type = type;
      request.type_filling = input_Filling_type;
      request.position = PositionGetInteger(POSITION_TICKET);
      request.price = type == ORDER_TYPE_BUY ?
                      SymbolInfoDouble(symbol, SYMBOL_ASK) :
                      SymbolInfoDouble(symbol, SYMBOL_BID);
      request.deviation = 100;

      if(OrderSend(request, result))
        {
         Print("Position closed: ", symbol, " Volume: ", DoubleToString(volume, 2));
         return;
        }
      else
        {
         int errorCode = GetLastError();
         Print("Close position failed (Attempt ", retryCount+1, "): ",
               "Error ", errorCode, " - ", GetErrorDescription(errorCode),
               " | Comment: ", result.comment);

         if(IsCriticalError(errorCode))
            return;

         retryCount++;
         if(retryCount < maxRetries)
            Sleep(200);
        }
     }

   Print("Close position failed after ", maxRetries, " attempts");
  }

