//+------------------------------------------------------------------+
//| 入力データ準備（特徴量: MA乖離＋MA傾き）                        |
//+------------------------------------------------------------------+
void PrepareInputData(string symbol, int symbolIndex, double &inputs[])
  {
   ArrayResize(inputs, 2); // 入力特徴量は2つ

// 特徴量1: MA乖離（位置） - (Close - MA) / ATR を正規化
   double maDistance = CalculateNormalizedMADistance(symbol, symbolIndex);
   inputs[0] = maDistance;

// 特徴量2: MA傾き（方向） - (MA - MA[n]) / (n * ATR) を正規化
   double maSlope = CalculateNormalizedMASlope(symbol, symbolIndex);
   inputs[1] = maSlope;

// デバッグ用: 特徴量の値を表示
   if(MathRand() % 100 == 0)   // 1%の確率で表示
     {
      double rawMA = GetRawMA(symbol, symbolIndex);
      double close = iClose(symbol, _Period, 0);
      double atr = GetATR(symbol, symbolIndex);

      Print(symbol, " - Close: ", DoubleToString(close, 5),
            ", MA: ", DoubleToString(rawMA, 5),
            ", ATR: ", DoubleToString(atr, 5),
            ", MA Distance (norm): ", DoubleToString(maDistance, 4),
            ", MA Slope (norm): ", DoubleToString(maSlope, 4));
     }
  }

//+------------------------------------------------------------------+
//| MA乖離（位置）の計算: (Close - MA) / ATR を正規化               |
//+------------------------------------------------------------------+
double CalculateNormalizedMADistance(string symbol, int symbolIndex)
  {
   double maValue[1];
   double atrValue = GetATR(symbol, symbolIndex);

   if(atrValue <= 0)
     {
      Print("Warning: Invalid ATR value for ", symbol);
      return 0.0;
     }

// MAの値を取得
   if(CopyBuffer(maHandles[symbolIndex], 0, 0, 1, maValue) == 1)
     {
      double close = iClose(symbol, _Period, 0);

      // MA乖離の計算: (Close - MA) / ATR
      double maDistance = (close - maValue[0]) / atrValue;

      // 正規化：設定された最大値でクリップしてから-1.0～1.0に変換
      maDistance = MathMin(MathMax(maDistance, -Max_MA_Distance), Max_MA_Distance);

      // -1.0～1.0の範囲に正規化
      double normalized = maDistance / Max_MA_Distance;

      return normalized;
     }

// エラー時は0を返す
   Print("Error: Failed to get MA value for ", symbol);
   return 0.0;
  }

//+------------------------------------------------------------------+
//| MA傾き（方向）の計算: (MA - MA[n]) / (n * ATR) を正規化         |
//+------------------------------------------------------------------+
double CalculateNormalizedMASlope(string symbol, int symbolIndex)
  {
   double maCurrent[1], maPrevious[1];
   double atrValue = GetATR(symbol, symbolIndex);

   if(atrValue <= 0)
     {
      Print("Warning: Invalid ATR value for ", symbol);
      return 0.0;
     }

// 現在のMAとn本前のMAを取得
   if(CopyBuffer(maHandles[symbolIndex], 0, 0, 1, maCurrent) == 1 &&
      CopyBuffer(maHandles[symbolIndex], 0, Slope_Period, 1, maPrevious) == 1)
     {

      // MA傾きの計算: (MA - MA[n]) / (n * ATR)
      double maSlope = (maCurrent[0] - maPrevious[0]) / (Slope_Period * atrValue);

      // 正規化：設定された最大値でクリップしてから-1.0～1.0に変換
      maSlope = MathMin(MathMax(maSlope, -Max_MA_Slope), Max_MA_Slope);

      // -1.0～1.0の範囲に正規化
      double normalized = maSlope / Max_MA_Slope;

      return normalized;
     }

// エラー時は0を返す
   Print("Error: Failed to get MA values for ", symbol);
   return 0.0;
  }

//+------------------------------------------------------------------+
//| 生のMA値を取得（デバッグ用）                                    |
//+------------------------------------------------------------------+
double GetRawMA(string symbol, int symbolIndex)
  {
   double maValue[1];
   if(CopyBuffer(maHandles[symbolIndex], 0, 0, 1, maValue) == 1)
     {
      return maValue[0];
     }
   return -1;
  }

//+------------------------------------------------------------------+
//| ATR値を取得                                                     |
//+------------------------------------------------------------------+
double GetATR(string symbol, int symbolIndex)
  {
   double atrValue[1];
   if(CopyBuffer(atrHandles[symbolIndex], 0, 0, 1, atrValue) == 1)
     {
      return atrValue[0];
     }
   return 0;
  }

