//+------------------------------------------------------------------+
//| ロットサイズ調整                                                |
//+------------------------------------------------------------------+
double AdjustLotSize(string symbol, double requestedLot, int errorCode)
  {
   double minLot = SymbolInfoDouble(symbol, SYMBOL_VOLUME_MIN);
   double maxLot = SymbolInfoDouble(symbol, SYMBOL_VOLUME_MAX);
   double stepLot = SymbolInfoDouble(symbol, SYMBOL_VOLUME_STEP);
   double balance = AccountInfoDouble(ACCOUNT_BALANCE);
   double equity = AccountInfoDouble(ACCOUNT_EQUITY);

// 無効なロットサイズエラー (131)
   if(errorCode == 131)
     {
      if(requestedLot < minLot)
         return minLot;
      if(requestedLot > maxLot)
         return maxLot;

      double adjustedLot = NormalizeDouble(requestedLot / stepLot, 0) * stepLot;
      if(adjustedLot != requestedLot)
         return adjustedLot;
     }

// 資金不足エラー (134)
   if(errorCode == 134)
     {
      double marginRequired;
      if(OrderCalcMargin(ORDER_TYPE_BUY, symbol, requestedLot, SymbolInfoDouble(symbol, SYMBOL_ASK), marginRequired))
        {
         double maxAffordableLot = requestedLot;
         while(marginRequired > equity * 0.8 && maxAffordableLot > minLot)
           {
            maxAffordableLot -= stepLot;
            if(!OrderCalcMargin(ORDER_TYPE_BUY, symbol, maxAffordableLot, SymbolInfoDouble(symbol, SYMBOL_ASK), marginRequired))
               break;
           }
         if(maxAffordableLot >= minLot)
            return maxAffordableLot;
        }
     }
   return -1;
  }

//+------------------------------------------------------------------+
//| 取引が許可されているか確認                                      |
//+------------------------------------------------------------------+
bool IsTradeAllowed(string symbol)
  {
   if(!SymbolInfoInteger(symbol, SYMBOL_SELECT))
      return false;
   if(!TerminalInfoInteger(TERMINAL_TRADE_ALLOWED))
      return false;
   if(!SymbolInfoInteger(symbol, SYMBOL_TRADE_MODE))
      return false;
   if(AccountInfoInteger(ACCOUNT_TRADE_EXPERT) == 0)
      return false;
   if(AccountInfoDouble(ACCOUNT_MARGIN_LEVEL) > 0 &&
      AccountInfoDouble(ACCOUNT_MARGIN_LEVEL) < 100)
      return false;
   return true;
  }

//+------------------------------------------------------------------+
//| ニューラルネットワーク出力の診断用関数                           |
//+------------------------------------------------------------------+
void AnalyzeNeuralNetworkOutput()
  {
   static datetime lastAnalysis = 0;
   if(TimeCurrent() - lastAnalysis < 3600)
      return; // 1時間ごとに実行

   lastAnalysis = TimeCurrent();

   Print("=== Neural Network Output Analysis (MA Position & Direction) ===");

   for(int i = 0; i < 3; i++)
     {
      string symbol = GetSymbolByIndex(i);
      if(symbol == "" || maHandles[i] == INVALID_HANDLE)
         continue;

      double inputs[2];
      PrepareInputData(symbol, i, inputs);
      double prediction = NeuralNetwork(inputs);

      double maDistance = inputs[0];
      double maSlope = inputs[1];

      // 非正規化された値を計算（理解しやすいように）
      double atr = GetATR(symbol, i);
      double rawMA = GetRawMA(symbol, i);
      double close = iClose(symbol, _Period, 0);

      double rawMADistance = (close - rawMA) / atr;
      double rawMASlope = CalculateRawMASlope(symbol, i);

      string signalType = "NEUTRAL";
      if(prediction >= BuyThreshold)
         signalType = "BUY";
      else
         if(prediction <= SellThreshold)
            signalType = "SELL";

      string maPosition = "AT MA";
      if(rawMADistance > 1.0)
         maPosition = "ABOVE MA (strong)";
      else
         if(rawMADistance > 0.5)
            maPosition = "ABOVE MA";
         else
            if(rawMADistance < -1.0)
               maPosition = "BELOW MA (strong)";
            else
               if(rawMADistance < -0.5)
                  maPosition = "BELOW MA";

      string trendDirection = "FLAT";
      if(rawMASlope > 0.5)
         trendDirection = "STRONG UPTREND";
      else
         if(rawMASlope > 0.1)
            trendDirection = "UPTREND";
         else
            if(rawMASlope < -0.5)
               trendDirection = "STRONG DOWNTREND";
            else
               if(rawMASlope < -0.1)
                  trendDirection = "DOWNTREND";

      Print(symbol, ": Close=", DoubleToString(close, 5),
            ", MA=", DoubleToString(rawMA, 5),
            ", Distance=", DoubleToString(rawMADistance, 2), " ATR (", maPosition, ")",
            ", Slope=", DoubleToString(rawMASlope, 4), " ATR/bar (", trendDirection, ")",
            " -> Prediction=", DoubleToString(prediction, 4),
            " (", signalType, ")");
     }
   Print("=================================================================");
  }

//+------------------------------------------------------------------+
//| 生のMA傾きを計算（デバッグ用）                                   |
//+------------------------------------------------------------------+
double CalculateRawMASlope(string symbol, int symbolIndex)
  {
   double maCurrent[1], maPrevious[1];
   double atrValue = GetATR(symbol, symbolIndex);

   if(atrValue <= 0)
      return 0;

// 現在のMAとn本前のMAを取得
   if(CopyBuffer(maHandles[symbolIndex], 0, 0, 1, maCurrent) == 1 &&
      CopyBuffer(maHandles[symbolIndex], 0, Slope_Period, 1, maPrevious) == 1)
     {

      // MA傾きの計算: (MA - MA[n]) / (n * ATR)
      double rawSlope = (maCurrent[0] - maPrevious[0]) / (Slope_Period * atrValue);

      return rawSlope;
     }

   return 0;
  }
